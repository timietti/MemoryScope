# .env.example  —  copy to .env and fill in values
# ⚠️  Never commit .env to source control

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────────
DB_PASSWORD=localdev
DATABASE_URL=postgresql+asyncpg://memoryscope:localdev@localhost:5432/memoryscope

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoryscope
S3_SECRET_KEY=change-me-min16chars

# ── AI APIs ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...             # optional fallback

# ── Enrichment ─────────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=               # optional, leave blank to skip VT enrichment

# ── Volatility3 ────────────────────────────────────────────────────────────────
VOLATILITY_PATH=/opt/volatility3/vol.py
SYMBOL_CACHE_PATH=/opt/volatility3/symbols

# ── App ────────────────────────────────────────────────────────────────────────
ENV=development
DOMAIN=memoryscope.local

# ── Seed (optional overrides for make seed) ────────────────────────────────────
# ADMIN_EMAIL=admin@memoryscope.local
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=changeme123!

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://memoryscope.local
