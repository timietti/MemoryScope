# .env.example  —  copy to .env and fill in values
# ⚠️  Never commit .env to source control
#
# Bootstrap settings (required at startup, cannot be stored in the DB):
#   SECRET_KEY, DATABASE_URL, REDIS_URL, S3_*
#
# First-run setup (admin account, AI provider, Volatility paths) is handled
# by the setup wizard at /setup — you do not need to set those here.
#
# Everything else is configured from Admin → Settings after first login.

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────────
DB_PASSWORD=localdev
DATABASE_URL=postgresql+asyncpg://memoryscope:localdev@localhost:5432/memoryscope

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoryscope
S3_SECRET_KEY=change-me-min16chars

# ── App ────────────────────────────────────────────────────────────────────────
ENV=development
DOMAIN=memoryscope.local

# ── Worker scaling (Docker Compose only) ───────────────────────────────────────
# Number of worker container replicas. Each replica is a separate Celery worker
# process. Keep at 1 per 16 GB RAM when processing large memory dumps (≥4 GB),
# since Volatility3 mmaps the full dump into page cache.
# Celery concurrency (child processes per replica) is set from Admin → Settings.
WORKER_REPLICAS=1

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://memoryscope.local

# ── Seed (optional overrides for make seed) ────────────────────────────────────
# ADMIN_EMAIL=admin@memoryscope.local
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=changeme123!

# All other runtime settings (AI keys, VirusTotal, Volatility paths, OIDC/SSO,
# retention, auth, Celery, watch folder) are configured from Admin → Settings
# in the UI after first login.
