# .env.example  —  copy to .env and fill in values
# ⚠️  Never commit .env to source control

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────────
DB_PASSWORD=localdev
DATABASE_URL=postgresql+asyncpg://memoryscope:localdev@localhost:5432/memoryscope

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoryscope
S3_SECRET_KEY=change-me-min16chars

# ── AI APIs ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...             # optional fallback

# ── Enrichment ─────────────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=               # optional, leave blank to skip VT enrichment

# ── Volatility3 ────────────────────────────────────────────────────────────────
VOLATILITY_PATH=/opt/volatility3/vol.py
SYMBOL_CACHE_PATH=/opt/volatility3/symbols

# ── App ────────────────────────────────────────────────────────────────────────
ENV=development
DOMAIN=memoryscope.local

# ── Seed (optional overrides for make seed) ────────────────────────────────────
# ADMIN_EMAIL=admin@memoryscope.local
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=changeme123!

# ── SSO / OIDC (Authentik) ─────────────────────────────────────────────────────
# Leave OIDC_CLIENT_ID empty (or unset) to disable SSO — no other vars are read.
#
# Setup in Authentik:
#   1. Create an OAuth2/OIDC Provider, set redirect URI to OIDC_REDIRECT_URI below.
#   2. Enable the "groups" scope so group membership is included in the id_token.
#   3. Create an Application linked to the provider and note the Client ID/Secret.
#
# OIDC_CLIENT_ID=memoryscope
# OIDC_CLIENT_SECRET=<paste client secret here>
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/memoryscope/.well-known/openid-configuration
# OIDC_REDIRECT_URI=https://memoryscope.example.com/api/v1/auth/oidc/callback
# OIDC_FRONTEND_CALLBACK_URL=https://memoryscope.example.com/auth/callback
# OIDC_PROVIDER_NAME=Authentik          # label on the login button
# OIDC_ADMIN_GROUP=memoryscope-admins   # Authentik group that grants admin role
# OIDC_JIT_PROVISIONING=false           # true = create unknown users on first login

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://memoryscope.local
