# .env.example  —  copy to .env and fill in values
# ⚠️  Never commit .env to source control
#
# Bootstrap settings (required at startup, cannot be stored in the DB):
#   SECRET_KEY, DATABASE_URL, REDIS_URL, S3_*
#
# Runtime settings (AI keys, model names, Volatility paths, OIDC, etc.) are
# seeded from .env on FIRST start and then managed from the Admin UI.
# After the first boot you can remove them from .env — the DB values take over.

# ── Security ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ───────────────────────────────────────────────────────────────────
DB_PASSWORD=localdev
DATABASE_URL=postgresql+asyncpg://memoryscope:localdev@localhost:5432/memoryscope

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage (MinIO / S3) ────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=memoryscope
S3_SECRET_KEY=change-me-min16chars

# ── App ────────────────────────────────────────────────────────────────────────
ENV=development
DOMAIN=memoryscope.local

# ── Frontend ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://memoryscope.local

# ── Seed (optional overrides for make seed) ────────────────────────────────────
# ADMIN_EMAIL=admin@memoryscope.local
# ADMIN_NAME=Administrator
# ADMIN_PASSWORD=changeme123!

# ── Initial runtime settings (seeded to DB on first start) ────────────────────
# Set these here for the initial boot; after that, edit them from Admin → Settings.
# Removing them from .env after first start is safe — DB values are used instead.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=                # optional fallback
VIRUSTOTAL_API_KEY=            # optional; leave blank to skip VT enrichment

VOLATILITY_PATH=/opt/volatility3/vol.py
SYMBOL_CACHE_PATH=/opt/volatility3/symbols

# ── SSO / OIDC (Authentik) ─────────────────────────────────────────────────────
# Leave OIDC_CLIENT_ID empty (or unset) to disable SSO.
# These are also runtime settings — configure from Admin UI after first start.
#
# OIDC_CLIENT_ID=memoryscope
# OIDC_CLIENT_SECRET=<paste client secret here>
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/memoryscope/.well-known/openid-configuration
# OIDC_REDIRECT_URI=https://memoryscope.example.com/api/v1/auth/oidc/callback
# OIDC_FRONTEND_CALLBACK_URL=https://memoryscope.example.com/auth/callback
# OIDC_PROVIDER_NAME=Authentik
# OIDC_ADMIN_GROUP=memoryscope-admins
# OIDC_JIT_PROVISIONING=false
