# infra/docker/Dockerfile.worker
# ──────────────────────────────────────────────────────────────────────────────
# Stage 1: Build Volatility3 and install symbols tooling
# ──────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS vol-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git build-essential libdwarf-dev libelf-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Volatility3 from source (pinned commit for reproducibility)
RUN git clone --depth 1 https://github.com/volatilityfoundation/volatility3.git /opt/volatility3

WORKDIR /opt/volatility3
RUN pip install --no-cache-dir -e ".[full]"

# Pre-download minimal symbol pack (Windows 10 common builds)
# In production, a full symbol sync happens via the shared PV on first run
RUN mkdir -p /opt/volatility3/symbols/windows \
             /opt/volatility3/symbols/linux \
             /opt/volatility3/symbols/mac

# ──────────────────────────────────────────────────────────────────────────────
# Stage 2: Final worker image
# ──────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS worker

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    # Volatility3 reads symbols from here; override via env if needed
    VOLATILITY_SYMBOL_SERVER=https://downloads.volatilityfoundation.org/volatility3/symbols/

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev libdwarf-dev libelf-dev \
    yara \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Volatility3 from builder
COPY --from=vol-builder /opt/volatility3 /opt/volatility3
COPY --from=vol-builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=vol-builder /usr/local/bin/vol /usr/local/bin/vol

# Install our backend deps
COPY backend/requirements.txt .
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/ ./backend/

# Security: non-root user, no shell
RUN groupadd -r worker && useradd -r -g worker -s /usr/sbin/nologin worker
RUN chown -R worker:worker /app /tmp
USER worker

# Health: worker is healthy if it can import Volatility3
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import volatility3; print('ok')" || exit 1

# Default: run Celery worker
# Override in docker-compose for beat/flower
CMD ["celery", "-A", "backend.workers.celery_app", "worker", \
     "--loglevel=info", "--concurrency=4", \
     "--queues=analysis,plugins,default", \
     "--max-tasks-per-child=10"]
