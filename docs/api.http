# docs/api.http
# VSCode REST Client — install extension: humao.rest-client
# Set @token after logging in

@base = http://localhost:8000/api/v1
@token = PASTE_TOKEN_HERE

### Health check
GET http://localhost:8000/health

### Login
# @name login
POST {{base}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin@memoryscope.local&password=changeme123!

### Get current user
GET {{base}}/auth/me
Authorization: Bearer {{token}}

### List cases
GET {{base}}/cases
Authorization: Bearer {{token}}

### List cases - filtered
GET {{base}}/cases?status=complete&page=1&page_size=10
Authorization: Bearer {{token}}

### Get case detail
GET {{base}}/cases/CASE_ID_HERE
Authorization: Bearer {{token}}

### List plugin runs for a case
GET {{base}}/cases/CASE_ID_HERE/plugins
Authorization: Bearer {{token}}

### Get specific plugin output
GET {{base}}/cases/CASE_ID_HERE/plugins/windows.malfind
Authorization: Bearer {{token}}

### Get AI report
GET {{base}}/cases/CASE_ID_HERE/report
Authorization: Bearer {{token}}

### Get IOCs
GET {{base}}/cases/CASE_ID_HERE/iocs?severity=high
Authorization: Bearer {{token}}

### Submit a case (multipart - use Swagger UI for file upload)
# Use http://localhost:8000/api/docs for file uploads
